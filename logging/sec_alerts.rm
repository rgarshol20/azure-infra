# =============================
# Azure Activity Logs for Security Monitoring
# =============================
data "azurerm_subscription" "current" {}

resource "azurerm_monitor_action_group" "alert" {
  provider = azurerm.dev  
  name                = "acme-health-dev-security-alerts"
  resource_group_name = azurerm_resource_group.logging.name
  short_name          = "SecAlert"

  email_receiver {
    name          = "SecurityTeam"
    email_address = "roryg@acme-health.com"
  }
}

resource "azurerm_monitor_activity_log_alert" "security_events" {
  provider = azurerm.dev  
  name                = "acme-health-dev-hipaa-security-events"
  location            = "global"
  resource_group_name = azurerm_resource_group.logging.name

  scopes = [
    "/subscriptions/${var.dev_subscription_id}"  # <- Must match current sub
  ]

  criteria {
    category       = "Administrative"
    operation_name = "Microsoft.Resources/deployments/write"
  }

  action {
    action_group_id = azurerm_monitor_action_group.alert.id
  }
}

resource "azurerm_monitor_data_collection_rule" "windows_dcr" {
  provider = azurerm.dev  
  name                = "acme-health-dev-windows-dcr"  # Match existing DCR
  resource_group_name      = azurerm_resource_group.logging.name
  location                 = azurerm_resource_group.logging.location
  kind                = "Windows"  # Ensure kind is set

  data_sources {
    windows_event_log {
      name           = "eventLogsDataSource"
      streams        = ["Microsoft-Event"]
      x_path_queries = [
        "Application!*[System[(Level=1 or Level=2 or Level=3 or Level=4 or Level=0 or Level=5)]]",
        "Security!*[System[(band(Keywords,13510798882111488))]]",
        "System!*[System[(Level=1 or Level=2 or Level=3 or Level=4 or Level=0 or Level=5)]]"
      ]
    }
  }

  destinations {
    log_analytics {
      name                  = "la-199618257"  # Keep Azure-generated name
      workspace_resource_id = azurerm_log_analytics_workspace.local_law.id
    }      
    

  }

  data_flow {
    streams      = ["Microsoft-Event"]
    destinations = ["la-199618257"]
  }

  tags = {}  # Ensure Terraform doesn’t try to remove empty tags
}